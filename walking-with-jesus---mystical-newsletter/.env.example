# Walking with Jesus - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# GEMINI AI API KEY (Required for message generator)
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
# Choose your email provider: convertkit, mailchimp, beehiiv, or custom
VITE_EMAIL_PROVIDER=convertkit

# --- ConvertKit ---
# Get these from: https://app.convertkit.com/account_settings/advanced_settings
VITE_EMAIL_API_KEY=your_convertkit_api_key
VITE_EMAIL_FORM_ID=your_convertkit_form_id

# --- Mailchimp ---
# Note: Mailchimp requires a backend proxy due to CORS restrictions
# VITE_EMAIL_API_KEY=your_mailchimp_api_key
# VITE_EMAIL_LIST_ID=your_mailchimp_list_id
# VITE_EMAIL_API_URL=/api/subscribe

# --- Beehiiv ---
# Get these from: https://www.beehiiv.com/dashboard/developers
# VITE_EMAIL_API_KEY=your_beehiiv_api_key
# VITE_EMAIL_LIST_ID=your_beehiiv_publication_id

# --- Custom API ---
# If you have your own backend API endpoint
# VITE_EMAIL_API_URL=https://your-api.com/subscribe

# ============================================
# ANALYTICS (Optional)
# ============================================
# Replace GA_MEASUREMENT_ID in index.html with your Google Analytics ID
# Example: G-XXXXXXXXXX

# ============================================
# DEVELOPMENT
# ============================================
# Leave empty to use demo mode (simulated email signup)
